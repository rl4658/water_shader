#version 400

layout (quads, equal_spacing) in; // Tesselate quads with uniform spacing

// Input from TCS
in VS_OUT {
    vec3 Position_worldspace;
    vec3 LightDirection;
    vec3 EyeDirection;
    vec2 uv;
} tes_in[];

// Output to geometry shader
out TES_OUT {
    vec3 Position_worldspace;
    vec3 LightDirection;
    vec3 EyeDirection;
    vec2 uv;
} tes_out;

void main() {
    // Read inputs from patch vertices
    vec3 p0 = tes_in[0].Position_worldspace;
    vec3 p1 = tes_in[1].Position_worldspace;
    vec3 p2 = tes_in[2].Position_worldspace;
    vec3 p3 = tes_in[3].Position_worldspace;

    vec3 l0 = tes_in[0].LightDirection;
    vec3 l1 = tes_in[1].LightDirection;
    vec3 l2 = tes_in[2].LightDirection;
    vec3 l3 = tes_in[3].LightDirection;

    vec3 e0 = tes_in[0].EyeDirection;
    vec3 e1 = tes_in[1].EyeDirection;
    vec3 e2 = tes_in[2].EyeDirection;
    vec3 e3 = tes_in[3].EyeDirection;

    vec2 u0 = tes_in[0].uv;
    vec2 u1 = tes_in[1].uv;
    vec2 u2 = tes_in[2].uv;
    vec2 u3 = tes_in[3].uv;

    float u = gl_TessCoord.x; // Horizontal coordinate [0, 1]
    float v = gl_TessCoord.y; // Vertical coordinate [0, 1]

    // Bilinear interpolate world position
    vec3 posA = mix(p0, p1, u);
    vec3 posB = mix(p3, p2, u);
    vec3 pos  = mix(posA, posB, v);
    tes_out.Position_worldspace = pos;

    // Bilinear interpolate light direction
    vec3 lightA = mix(l0, l1, u);
    vec3 lightB = mix(l3, l2, u);
    tes_out.LightDirection = mix(lightA, lightB, v);

    // Bilinear interpolate eye direction
    vec3 eyeA = mix(e0, e1, u);
    vec3 eyeB = mix(e3, e2, u);
    tes_out.EyeDirection = mix(eyeA, eyeB, v);

    // Bilinear interpolate UV
    vec2 uvA = mix(u0, u1, u);
    vec2 uvB = mix(u3, u2, u);
    tes_out.uv = mix(uvA, uvB, v);

    gl_Position = vec4(pos, 1.0); // Output placeholder position
}