#version 400

layout (vertices = 4) out; // Patch contains 4 control points (quad)

// Input vertex data from vertex shader
in VS_OUT {
    vec3 Position_worldspace;
    vec3 LightDirection;
    vec3 EyeDirection;
    vec2 uv;
} tcs_in[];

// Output vertex data to TES
out VS_OUT {
    vec3 Position_worldspace;
    vec3 LightDirection;
    vec3 EyeDirection;
    vec2 uv;
} tcs_out[];

// Uniform tessellation levels
uniform float outerTess;
uniform float innerTess;

void main() {
    // Pass through per-vertex data
    tcs_out[gl_InvocationID].Position_worldspace = tcs_in[gl_InvocationID].Position_worldspace;
    tcs_out[gl_InvocationID].LightDirection = tcs_in[gl_InvocationID].LightDirection;
    tcs_out[gl_InvocationID].EyeDirection = tcs_in[gl_InvocationID].EyeDirection;
    tcs_out[gl_InvocationID].uv = tcs_in[gl_InvocationID].uv;

    // Set tessellation levels once per patch
    if (gl_InvocationID == 0) {
        gl_TessLevelOuter[0] = outerTess;
        gl_TessLevelOuter[1] = outerTess;
        gl_TessLevelOuter[2] = outerTess;
        gl_TessLevelOuter[3] = outerTess;

        gl_TessLevelInner[0] = innerTess;
        gl_TessLevelInner[1] = innerTess;
    }
}