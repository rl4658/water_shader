#version 400

// Vertex input attributes
layout(location = 0) in vec3 vertexPosition_modelspace;
layout(location = 1) in vec3 vertexNormal_modelspace;

// Output to TCS
out VS_OUT {
    vec3 Position_worldspace;
    vec3 LightDirection;
    vec3 EyeDirection;
    vec2 uv;
} vs_out;

// Uniforms
uniform mat4 Model;
uniform vec3 LightPosition_worldspace;
uniform vec3 EyePosition_worldspace;
uniform float time;
uniform vec2 texOffset;
uniform float texScale;

void main() {
    // Transform vertex to world space
    vec4 position_world = Model * vec4(vertexPosition_modelspace, 1.0);
    vs_out.Position_worldspace = position_world.xyz;

    // Compute light and eye directions in world space
    vs_out.LightDirection = LightPosition_worldspace - position_world.xyz;
    vs_out.EyeDirection   = EyePosition_worldspace - position_world.xyz;

    // Compute animated UVs using world XZ position
    vec2 posXZ = position_world.xz;
    vs_out.uv = (posXZ + texOffset + time * 0.08) / texScale;
}