#version 400

// Interpolated values from the geometry shader
in vec3 normal_geom;
in vec3 position_geom;
in vec3 eye_geom;
in vec3 light_geom;
in vec2 uv_geom;

// Output color
out vec4 color_out;

// Texture input
uniform sampler2D waterTexture;
uniform vec4 modelcolor;

void phongColor() {
    vec3 N = normalize(normal_geom);        // Normal vector
    vec3 L = normalize(light_geom);         // Light direction
    vec3 E = normalize(eye_geom);           // Eye direction
    vec3 R = reflect(-L, N);                // Reflection vector

    vec4 LightColor = vec4(1.0, 1.0, 1.0, 1.0); // Light color

    vec4 MaterialDiffuseColor = texture(waterTexture, uv_geom);               // Base texture color
    vec4 MaterialAmbientColor = vec4(0.2, 0.2, 0.2, modelcolor.a) * MaterialDiffuseColor; // Ambient
    vec4 MaterialSpecularColor = vec4(0.7, 0.7, 0.7, modelcolor.a);           // Specular

    float cosTheta = clamp(dot(N, L), 0.0, 1.0);    // Diffuse intensity
    float cosAlpha = clamp(dot(E, R), 0.0, 1.0);    // Specular intensity

    color_out =
        MaterialAmbientColor +
        MaterialDiffuseColor * LightColor * cosTheta +
        MaterialSpecularColor * LightColor * pow(cosAlpha, 8.0); // Final color
}

void main() {
    phongColor();
}